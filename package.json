{
  "name": "kora-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "On-chain Invoice Financing Protocol built on Stellar Soroban",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:components": "playwright test --project=components",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:a11y": "playwright test e2e/a11y-audit.spec.ts",
    "test:a11y:all": "playwright test e2e/a11y-audit.spec.ts e2e/accessibility.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:unused": "node scripts/check-i18n.mjs --unused",
    "check:i18n:unused:strict": "node scripts/check-i18n.mjs --unused --strict"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^0.9.2",
    "@ducanh2912/next-pwa": "10.2.9",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stellar/stellar-sdk": "^12.3.0",
    "@tanstack/query-persist-client-core": "^5.101.4",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-query-devtools": "^5.56.2",
    "@tanstack/react-virtual": "3.13.2",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.5.4",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "^0.441.0",
    "next": "15.0.0",
    "next-intl": "^4.13.4",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "2.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.0",
    "jsdom": "^23.0.1",
    "lint-staged": "15.2.10",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "vitest": "^1.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "bash -c 'tsc --noEmit --skipLibCheck'"
    ],
    "*.{js,jsx,cjs,mjs}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "overrides": {
    "@tanstack/query-core": "5.101.4"
  }
}
